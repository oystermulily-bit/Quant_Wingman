# 复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会上传 GitHub）
#
# MT5 实盘 / 数据拉取（run.py、live_trade.py、download_full_history.py 等）
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Demo

# RD-Agent / 硅基流动
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Pro
W1NGMAN_GENERATOR_BACKEND=rd_agent
RD_AGENT_ROUNDS=30

# Web 密钥只从环境读取，不会写入 web_settings.json
W1NGMAN_AI_API_KEY=your_optional_generic_ai_api_key
W1NGMAN_FEISHU_WEBHOOK_URL=your_feishu_webhook_url
W1NGMAN_FEISHU_SECRET=your_feishu_signing_secret
